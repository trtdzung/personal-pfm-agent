# server.py only needs: requirements.txt, server.py, text_utils.py,
# instructions.md, middleware/, data/, tools/memory_tools.py,
# skills/project/ (data-visualization SKILL.md, read via FilesystemBackend --
# see server.py's build_agent()). Everything else below is excluded --
# whenever a new file/directory is added at the repo root that server.py
# does NOT need, add it here too, or it silently ends up in the image
# (this is the tradeoff of COPY . . + .dockerignore vs. an explicit
# COPY allowlist -- nothing enforces this list stays exhaustive).

# VCS / tooling / caches
.git/
.github/
.gitignore
.dockerignore
.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/
.superpowers/
.mda/

# secrets -- never bake these into the image
.env
.env.*
.greennode.json

# the managed (mda dev/mda deploy) agent -- unrelated to this server,
# and identity.py/memory.py/pyproject.toml/uv.lock carry that deployment's
# own configuration, not this one's
agent.py
identity.py
memory.py
pyproject.toml
uv.lock

# managed-deploy-only scaffold pieces (channels/connectors/schedules/sandbox
# are opt-in-by-presence for `mda`, not used by this server) and other
# local-dev-only content.
# NOTE: tools/ is NOT excluded -- tools/memory_tools.py (remember_preference/
# recall_preference) is a real runtime dependency of server.py.
# NOTE: skills/ is NOT excluded -- server.py's build_agent() reads
# skills/project/data-visualization/SKILL.md at runtime via FilesystemBackend.
channels/
connectors/
schedules/
sandbox/
scripts/
notebooks/
evals/
tests/
docs/

# docs / misc, not needed at runtime
README.md
todo.md
RM Customer 360.dc.html
